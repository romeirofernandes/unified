{
  "display_information": {
    "name": "Unified",
    "description": "feedback digests for your team",
    "background_color": "#5476b7"
  },
  "features": {
    "bot_user": {
      "display_name": "Unified",
      "always_online": false
    }
  },
  "oauth_config": {
    "redirect_urls": ["https://YOUR_BACKEND_HOST/api/slack/callback"],
    "scopes": { "bot": ["incoming-webhook"] }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
