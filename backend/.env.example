# Comma-separated server-only Groq API keys. Never use a VITE_ prefix.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Digest delivery. Choose smtp or resend. SMTP requires a real email provider.
EMAIL_TRANSPORT=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# FROM_EMAIL is the sender address, e.g. your authenticated Gmail account for Gmail SMTP.
# DIGEST_EMAIL_FROM remains supported for older configurations.
FROM_EMAIL=
FRONTEND_URL=http://localhost:5173
# Production: a persistent 32-byte hex key, shared across all backend replicas.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Without this, local development persists a key in backend/.data/integration-key.
INTEGRATION_ENCRYPTION_KEY=

# Slack install flow. Configure this exact HTTPS callback in your Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR_BACKEND_HOST/api/slack/callback
