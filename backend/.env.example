# Comma-separated server-only Groq API keys. Never use a VITE_ prefix.
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Digest delivery. Choose smtp or resend. SMTP requires a real email provider.
EMAIL_TRANSPORT=resend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# FROM_EMAIL is the sender address, e.g. your authenticated Gmail account for Gmail SMTP.
# DIGEST_EMAIL_FROM remains supported for older configurations.
FROM_EMAIL=
FRONTEND_URL=http://localhost:5173
# Production: a persistent 32-byte hex key, shared across all backend replicas.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Without this, local development persists a key in backend/.data/integration-key.
INTEGRATION_ENCRYPTION_KEY=

# Slack install flow. Configure this exact HTTPS callback in your Slack app.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR_BACKEND_HOST/api/slack/callback

# Same public project ID and web API key used by the dashboard Firebase app.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Use a replica set (including MongoDB Atlas) for atomic feedback/deletion.
# Set to your actual reverse-proxy hop count when hosted behind a proxy.
TRUST_PROXY_HOPS=0

# Configure payment.captured at /api/payment/webhook to reconcile late captures.
RAZORPAY_WEBHOOK_SECRET=

# GitHub App for scoped draft PRs. Permissions: Contents and Pull requests read/write,
# Checks and Commit statuses read-only, Metadata read-only. Install on selected repos.
# Enable user authorization (OAuth) and configure this callback. User tokens are
# used only during connection and are not persisted.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key, with literal \n between lines when supplied through an env file.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CALLBACK_URL=http://localhost:8000/api/github/callback

# GitHub App webhook: /api/github/webhook. Subscribe to Pull requests,
# Check runs, Check suites and Status. Use the same secret in the app settings.
GITHUB_APP_WEBHOOK_SECRET=
