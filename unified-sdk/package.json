    "@fontsource/bricolage-grotesque": "^5.2.7",
    "@fontsource/inter": "^5.2.5",
    "@tailwindcss/vite": "^4.1.7",
    "clsx": "^2.1.1",
    "magic-string": "^0.30.21",
