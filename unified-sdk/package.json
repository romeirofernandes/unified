{
  "name": "unified-sdk",
  "private": false,
  "version": "2.2.1",
  "type": "module",
  "main": "dist/unified-sdk.umd.cjs",
  "module": "dist/unified-sdk.es.js",
  "style": "dist/unified-sdk.css",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/unified-sdk.es.js",
      "require": "./dist/unified-sdk.umd.cjs"
    },
    "./dist/unified-sdk.css": "./dist/unified-sdk.css"
  },
  "files": [
    "dist",
    "cli",
    "types",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:consumer": "npm run build && node scripts/test-consumer.mjs",
    "prepublishOnly": "npm test && npm run test:consumer && npm run test:consumer:next",
    "test:consumer:next": "npm run build && node scripts/test-next-consumer.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.29.13",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "clsx": "^2.1.1",
    "magic-string": "^0.30.21",
    "motion": "^14.10.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "@tailwindcss/vite": "^4.1.7",
    "tailwindcss": "^4.1.7"
  },
  "description": "A unified feedback SDK for React applications",
  "author": "Romeiro Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romeirofernandes/unified.git"
  },
  "keywords": [
    "react",
    "feedback",
    "sdk",
    "unified"
  ],
  "bin": {
    "unified-sdk": "cli/bin.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "types": "./types/index.d.ts",
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md"
}
